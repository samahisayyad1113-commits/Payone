PAYONE_DB_URL=jdbc:postgresql://localhost:5432/payone
PAYONE_DB_USER=payone
PAYONE_DB_PASSWORD=change-me
PAYONE_REDIS_HOST=localhost
PAYONE_REDIS_PORT=6379
PAYONE_LOCAL_USER=00000000-0000-0000-0000-000000000001
PAYONE_LOCAL_PASSWORD=change-me
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=do-not-commit
RAZORPAY_WEBHOOK_SECRET=do-not-commit
RAZORPAY_BASE_URL=https://api.razorpay.com
PAYONE_RECONCILIATION_ENABLED=true
PAYONE_RECONCILIATION_INITIAL_DELAY_MS=15000
PAYONE_RECONCILIATION_TOPUPS_DELAY_MS=60000
PAYONE_RECONCILIATION_REFUNDS_DELAY_MS=120000
PAYONE_RECONCILIATION_WEBHOOKS_DELAY_MS=30000

# Set a high-entropy secret per payout provider webhook; never use this development file in production.
PAYONE_PAYOUT_WEBHOOK_SECRET=
PAYONE_PAYOUT_WEBHOOK_TOLERANCE_SECONDS=300

# Stage 63 payout-provider sandbox selection (local test doubles only)
# Supported identifiers: RAZORPAYX, CASHFREE_PAYOUTS, CUSTOM
# Do not use sandbox test doubles for production payouts.
PAYONE_PAYOUT_PROVIDER=RAZORPAYX
PAYONE_PAYOUT_MODE=SANDBOX

# Stage 64 safety defaults: keep live transfers disabled until all sign-offs are complete.
PAYONE_PAYOUT_LIVE_ENABLED=false
PAYONE_PAYOUT_ALLOW_LIVE_TRANSFERS=false

# Stage 65: only use RazorpayX TEST keys for this adapter.
# The HTTP adapter is opt-in and not wired automatically.
PAYONE_RAZORPAYX_TESTMODE_ENABLED=false
PAYONE_RAZORPAYX_TEST_KEY_ID=
PAYONE_RAZORPAYX_TEST_KEY_SECRET=
PAYONE_RAZORPAYX_TEST_CUSTOMER_IDENTIFIER=
PAYONE_RAZORPAYX_TEST_MODE=IMPS
PAYONE_RAZORPAYX_TEST_PURPOSE=payout

# Stage 71 email alerts: delivery remains disabled unless explicitly enabled.
PAYONE_ALERT_EMAIL_ENABLED=false
PAYONE_ALERT_EMAIL_RECIPIENT=
PAYONE_ALERT_EMAIL_MAX_ATTEMPTS=5
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
